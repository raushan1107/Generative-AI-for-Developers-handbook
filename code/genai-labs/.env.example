# Copy this file to .env in your genai-labs folder. Never commit .env.
# The default is a FREE local model with Ollama: no account and no key needed.
# Install Ollama, then run once:   ollama pull llama3.2      (and for Module 05+:  ollama pull nomic-embed-text)

# Which provider llm.py uses: ollama (default) | azure | openai
LLM_PROVIDER=ollama

# --- Ollama, local and free (default) ---
OLLAMA_MODEL=llama3.2

# --- Azure OpenAI in Microsoft Foundry (optional: set LLM_PROVIDER=azure) ---
# Your endpoint + "openai/v1/" at the end
AZURE_OPENAI_BASE_URL=https://<resource-name>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<paste key from the Foundry portal>
AZURE_OPENAI_DEPLOYMENT=chat

# --- OpenAI (optional: set LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Anthropic Claude (optional, used in "Open alternative" boxes) ---
ANTHROPIC_API_KEY=

# --- Cost meter (USD per 1M tokens; local models cost $0, so these matter only for paid providers) ---
PRICE_IN_PER_M=0.40
PRICE_OUT_PER_M=1.60

# --- Model comparison drill (optional) ---
COMPARE_DEPLOYMENT=
COMPARE_WITH_OLLAMA=0
