# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=azure
AZURE_OPENAI_BASE_URL=https://<resource-name>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<paste key from the Foundry portal>
AZURE_OPENAI_DEPLOYMENT=chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OLLAMA_MODEL=llama3.2

# New in milestone 2
MAX_TURNS_KEPT=6
PRICE_IN_PER_M=0.40
PRICE_OUT_PER_M=1.60
LOG_FILE=assist.log

# New in milestone 4
MAX_TOOL_ROUNDS=4
TICKETS_FILE=data/tickets.jsonl
# Set to none if the model says "Function tools with reasoning_effort are not supported"
TOOLS_REASONING_EFFORT=

# New in milestone 5
AZURE_OPENAI_EMBED_DEPLOYMENT=embed
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_EMBED_MODEL=nomic-embed-text
SEARCH_BACKEND=local
INDEX_DIR=data/index
# Only for SEARCH_BACKEND=azure
AZURE_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_SEARCH_API_KEY=<admin key from the portal>
AZURE_SEARCH_INDEX=traincrest
